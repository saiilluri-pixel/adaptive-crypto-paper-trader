# Live runtime state (regenerated by run.py; never source-of-truth)
state.json
paper.log
trades*.csv
equity*.csv
archive/

# launchd/legacy log output
launchd_*.out
launchd_*.err
dash_stdout.log
live_stdout.log
autotune_out.txt
autotune_all.txt

# research artifacts (regenerable from cached data + scripts)
research/data/
research/reports/*.html
research/reports/*.json

# Shock-continuation forward-shadow runtime (regenerated; never source-of-truth
# -- state.json/paper.log/trades*.csv/equity*.csv already covered above since
# those patterns have no leading slash and match at any depth)
shadow/*/events.csv
shadow/*/config_snapshot.json
shadow/*/*.tmp
shadow/*/diagnostics/*.jsonl

# Adaptive Spot paper trader runtime (regenerated; never source-of-truth --
# state.json/paper.log/trades*.csv already covered above)
adaptive_runtime/decisions.jsonl
adaptive_runtime/adaptation_log.jsonl
adaptive_runtime/dashboard.json
adaptive_runtime/champion_state.json
adaptive_runtime/champion_state.json.tmp
adaptive_runtime/research_status.json
adaptive_runtime/research.log
adaptive_runtime/research_cache/

# SIMULATED short/margin book runtime (adaptive/short_portfolio.py) --
# same "regenerated, never source-of-truth" status as the long book's
# files above; short_trades.csv isn't caught by the trades*.csv pattern
# above since that only matches names STARTING with "trades".
adaptive_runtime/short_state.json
adaptive_runtime/short_trades.csv
adaptive_runtime/short_decisions.jsonl

# Python
__pycache__/
*.pyc
.pytest_cache/

# env / secrets
.env
.env.*
*.pem
*.key

# virtual environments
venv/
.venv/
env/

# OS
.DS_Store
